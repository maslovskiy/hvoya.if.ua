// PROTOTYPE review deploy — static Vite build served by Cloudflare Workers static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hvoya-prototype",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // client-side routes (/product/:slug, /checkout) fall back to index.html
    "not_found_handling": "single-page-application"
  }
}
